# Configuração local da Huli. Nunca coloque chaves ou senhas reais no Git.
HULI_ENV=development
HULI_LOG_LEVEL=INFO
HULI_DATA_DIR=data
HULI_TIMEZONE=America/Sao_Paulo
HULI_CONTEXT_TURNS=20

# Local usado no resumo matinal. A consulta Open-Meteo é gratuita e sem chave.
HULI_WEATHER_LOCATION=São Paulo, São Paulo
HULI_WEATHER_LATITUDE=-23.5505
HULI_WEATHER_LONGITUDE=-46.6333

# API local. 127.0.0.1 evita exposição externa acidental.
HULI_API_HOST=127.0.0.1
HULI_API_PORT=8765

# Segurança
HULI_SESSION_HOURS=168
HULI_MAX_INPUT_CHARS=10000
# false abre o painel/terminal diretamente como Rony. A API continua autenticada.
HULI_LOCAL_LOGIN_ENABLED=false
HULI_LOCAL_OWNER_NAME=Rony

# O cofre do diário apaga a chave da memória após este período sem uso.
HULI_JOURNAL_LOCK_MINUTES=15

# Voz local do Windows. O microfone e a fala não usam serviços externos.
HULI_VOICE_AUTO_SPEAK=false
HULI_VOICE_INPUT_TIMEOUT=12
HULI_VOICE_LANGUAGE=pt-BR
HULI_VOICE_RATE=0
HULI_VOICE_VOLUME=100
HULI_VOICE_INPUT_PROVIDER=auto
HULI_VOICE_MODEL_PATH=models/vosk-pt
HULI_VOICE_WHISPER_MODEL_PATH=models/whisper-small
# Vazio utiliza o microfone padrao; aceita indice ou parte do nome.
HULI_VOICE_INPUT_DEVICE=
# Ganho digital do microfone (1.0 = original; permitido: 0.5 a 4.0)
HULI_VOICE_INPUT_GAIN=1.8
HULI_VOICE_START_LISTENING=false
# Ativação local em segundo plano. O teclado sempre tem prioridade.
HULI_VOICE_WAKE_ENABLED=false
HULI_VOICE_WAKE_CYCLE_TIMEOUT=30
# Espera após chamado sem comando, evitando reativações repetidas por ruído.
HULI_VOICE_WAKE_REARM_DELAY=3.0

# Modo residente: fechar/minimizar mantém a Huli na bandeja do Windows.
HULI_DESKTOP_RESIDENT_ENABLED=true
HULI_DESKTOP_START_MINIMIZED=false
HULI_DESKTOP_NOTIFICATIONS_ENABLED=true

# Google Calendar: a credencial OAuth fica fora do Git, em credentials/.
HULI_GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/google_calendar_oauth.json
# Janela futura sincronizada a partir de agora (1 a 365 dias).
HULI_GOOGLE_CALENDAR_SYNC_DAYS=90
