# Configuração local da Huli. Nunca coloque chaves ou senhas reais no Git.
HULI_ENV=development
HULI_LOG_LEVEL=INFO
HULI_DATA_DIR=data

# API local. 127.0.0.1 evita exposição externa acidental durante a Fase 0.
HULI_API_HOST=127.0.0.1
HULI_API_PORT=8765

# Segurança
HULI_SESSION_HOURS=168
HULI_MAX_INPUT_CHARS=10000
